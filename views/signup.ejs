<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Flower Haven - Sign Up</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@300;400&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Roboto', 'sans-serif'],
                        serif: ['"Playfair Display"', 'serif'],
                    },
                    colors: {
                        'pub-brown': '#3e2715',
                        'pub-gold': '#c77e24',
                        'pub-cream': '#f8e0b3',
                    },
                }
            }
        }
    </script>
    <style>
        #error-message {
            color: #ff4444; /* Màu đỏ cho thông báo lỗi */
            font-size: 0.875rem; /* Kích thước chữ nhỏ */
            margin-top: 0.5rem; /* Khoảng cách trên */
            display: none; /* Ẩn mặc định */
        }
    </style>
</head>
<body class="bg-[url('https://images.unsplash.com/photo-1688475747567-a06ecbb15053?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTB8fGZsb3dlcnMlMjBiZ3xlbnwwfHwwfHx8MA%3D%3D')] bg-cover bg-center min-h-screen flex items-center justify-center px-4">
    <div class="absolute inset-0 bg-black opacity-60"></div>
    <div class="w-full max-w-md relative z-10">
        <a href="#" class="flex items-center justify-center mb-6 text-2xl font-serif text-pub-cream">
            <img class="w-10 h-10 mr-2" src="https://images.unsplash.com/photo-1519455392209-a5ed92e171da?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8N3x8aWNvbiUyMGZsb3dlcnN8ZW58MHx8MHx8fDA%3D" alt="flower icon">
            The Flower Haven
            <img class="w-10 h-10 ml-2" src="https://images.unsplash.com/photo-1519455392209-a5ed92e171da?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8N3x8aWNvbiUyMGZsb3dlcnN8ZW58MHx8MHx8fDA%3D" alt="flower icon">
        </a>
        <div class="bg-pub-brown bg-opacity-90 p-8 rounded-lg shadow-2xl">
            <h1 class="text-xl font-bold leading-tight tracking-tight text-pub-cream mb-6">
                Create a new account
            </h1>
            <form id="signupForm" class="space-y-4">
                <div>
                    <label for="name" class="block mb-2 text-sm font-medium text-pub-cream">Username</label>
                    <input type="text" name="name" id="name" class="w-full px-3 py-2 bg-pub-cream border border-pub-gold rounded-md text-pub-brown placeholder-pub-brown/70 focus:outline-none focus:ring-2 focus:ring-pub-gold" placeholder="Your username">
                </div>
                <div>
                    <label for="email" class="block mb-2 text-sm font-medium text-pub-cream">Email</label>
                    <input type="email" name="email" id="email" class="w-full px-3 py-2 bg-pub-cream border border-pub-gold rounded-md text-pub-brown placeholder-pub-brown/70 focus:outline-none focus:ring-2 focus:ring-pub-gold" placeholder="name@company.com">
                </div>
                <div>
                    <label for="password" class="block mb-2 text-sm font-medium text-pub-cream">Password</label>
                    <input type="password" name="password" id="password" placeholder="••••••••" class="w-full px-3 py-2 bg-pub-cream border border-pub-gold rounded-md text-pub-brown placeholder-pub-brown/70 focus:outline-none focus:ring-2 focus:ring-pub-gold">
                </div>
                <div>
                    <label for="confirmpassword" class="block mb-2 text-sm font-medium text-pub-cream">Confirm Password</label>
                    <input type="password" name="confirmpassword" id="confirmpassword" placeholder="••••••••" class="w-full px-3 py-2 bg-pub-cream border border-pub-gold rounded-md text-pub-brown placeholder-pub-brown/70 focus:outline-none focus:ring-2 focus:ring-pub-gold">
                </div>
                <div>
                    <label for="age" class="block mb-2 text-sm font-medium text-pub-cream">Age</label>
                    <input type="number" name="age" id="age" class="w-full px-3 py-2 bg-pub-cream border border-pub-gold rounded-md text-pub-brown placeholder-pub-brown/70 focus:outline-none focus:ring-2 focus:ring-pub-gold" placeholder="Your age">
                </div>
                <button type="submit" class="w-full bg-pub-gold text-white py-2 px-4 rounded-md hover:bg-amber-600 transition duration-300 ease-in-out">Sign up</button>
                <p id="error-message"></p>
                <p class="text-sm font-light text-pub-cream mt-4">
                    Already have an account? <a href="/login" class="font-medium text-pub-gold hover:underline">Sign in</a>
                </p>
            </form>
        </div>
    </div>

    <script>
        document.getElementById("signupForm").addEventListener("submit", function (e) {
            e.preventDefault(); // Ngăn form submit mặc định

            const name = document.getElementById("name").value;
            const email = document.getElementById("email").value;
            const password = document.getElementById("password").value;
            const confirmpassword = document.getElementById("confirmpassword").value;
            const age = document.getElementById("age").value;
            const errorMessage = document.getElementById("error-message");

            // Xóa thông báo lỗi cũ
            errorMessage.style.display = "none";
            errorMessage.innerText = "";

            // Kiểm tra client-side
            if (!name) {
                errorMessage.innerText = "Vui lòng nhập tên";
                errorMessage.style.display = "block";
                return;
            }
            if (!email) {
                errorMessage.innerText = "Vui lòng nhập email";
                errorMessage.style.display = "block";
                return;
            }
            if (!password) {
                errorMessage.innerText = "Vui lòng nhập mật khẩu";
                errorMessage.style.display = "block";
                return;
            }
            if (!confirmpassword) {
                errorMessage.innerText = "Vui lòng nhập lại mật khẩu";
                errorMessage.style.display = "block";
                return;
            }
            if (password !== confirmpassword) {
                errorMessage.innerText = "Mật khẩu xác nhận không khớp";
                errorMessage.style.display = "block";
                return;
            }
            if (!age) {
                errorMessage.innerText = "Vui lòng nhập tuổi";
                errorMessage.style.display = "block";
                return;
            }

            fetch("/signup", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name, email, password, confirmpassword, age }),
            })
            .then(response => response.json()) // Luôn parse JSON, bất kể status
            .then(data => {
                if (data.success) {
                    window.location.href = "/login"; // Chuyển hướng đến trang đăng nhập
                } else {
                    errorMessage.innerText = data.message; // Hiển thị lỗi từ backend
                    errorMessage.style.display = "block";
                }
            })
            .catch(error => {
                console.error("Error:", error);
                errorMessage.innerText = "Đã xảy ra lỗi khi đăng ký: " + error.message;
                errorMessage.style.display = "block";
            });
        });
    </script>
</body>
</html>